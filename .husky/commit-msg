#!/usr/bin/env sh
# Conventional Commits: type(scope): description (см. CONTRIBUTING.md)
message=$(head -n 1 "$1")

case "$message" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|refactor|test|chore|ci|docs|build)\([a-z0-9][a-z0-9-]*\)!?: .+$'

if ! printf '%s\n' "$message" | grep -Eq "$pattern"; then
  echo "Invalid commit message: $message"
  echo "Expected: type(scope): description"
  echo "Types: feat, fix, refactor, test, chore, ci, docs, build"
  echo "Example: fix(engine): keep the caret after undoing a split"
  exit 1
fi
