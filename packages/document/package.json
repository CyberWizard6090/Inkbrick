{
  "name": "@inkbrick/document",
  "version": "0.1.0-alpha.0",
  "description": "Block document model for Inkbrick: schemas, validation, serialization, migrations and export. No React, no DOM.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.1.12",
    "vite": "^7.3.7"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CyberWizard6090/Inkbrick.git",
    "directory": "packages/document"
  }
}
