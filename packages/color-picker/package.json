{
  "name": "@inkbrick/color-picker",
  "version": "0.1.0-alpha.0",
  "description": "A colour picker with an alpha channel (saturation and brightness area, hue and opacity sliders, HEX / RGB / HSB fields) in plain DOM: works with React, Vue, Svelte or no framework at all.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "jsdom": "^29.1.1"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CyberWizard6090/Inkbrick.git",
    "directory": "packages/color-picker"
  }
}
