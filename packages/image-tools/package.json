{
  "name": "@inkbrick/image-tools",
  "version": "0.1.0-alpha.0",
  "description": "Image cropping (shapes, aspect ratios, a full-screen crop window) and a full-screen image viewer in plain DOM: works with React, Vue, Svelte or no framework at all.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src",
    "THIRD_PARTY_NOTICES.md",
    "ICONS_LICENSE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "jsdom": "^29.1.1"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CyberWizard6090/Inkbrick.git",
    "directory": "packages/image-tools"
  }
}
