{
  "name": "@inkbrick/engine",
  "version": "0.1.0-alpha.0",
  "description": "Headless Inkbrick editor: commands, intents and block controllers. Usable on a server.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts",
    "./html": "./src/html.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node ../../scripts/build-modules.mjs"
  },
  "dependencies": {
    "@inkbrick/document": "workspace:*",
    "@inkbrick/store": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "import": "./dist/internal.js"
      },
      "./html": {
        "types": "./dist/html.d.ts",
        "import": "./dist/html.js"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CyberWizard6090/Inkbrick.git",
    "directory": "packages/engine"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^29.1.1"
  }
}
