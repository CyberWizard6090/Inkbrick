{
  "name": "@inkbrick/store",
  "version": "0.1.0",
  "description": "Inkbrick document store: transactions with rollback, undo/redo history and subscriptions. No React.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@inkbrick/document": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CyberWizard6090/Inkbrick.git",
    "directory": "packages/store"
  }
}
