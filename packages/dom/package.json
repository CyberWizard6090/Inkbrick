{
  "name": "@inkbrick/dom",
  "version": "0.1.0-alpha.0",
  "description": "Inkbrick UI parts in plain DOM, usable without the editor and with any framework (React, Vue, Svelte or none): a colour picker with an alpha channel, an image crop window and a full-screen image viewer.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./color-picker": "./src/color-picker/index.ts",
    "./image-tools": "./src/image-tools/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "THIRD_PARTY_NOTICES.md",
    "ICONS_LICENSE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node ../../scripts/build-modules.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "jsdom": "^29.1.1"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./color-picker": {
        "types": "./dist/color-picker/index.d.ts",
        "import": "./dist/color-picker/index.js"
      },
      "./image-tools": {
        "types": "./dist/image-tools/index.d.ts",
        "import": "./dist/image-tools/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CyberWizard6090/Inkbrick.git",
    "directory": "packages/dom"
  }
}
