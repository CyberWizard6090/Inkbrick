{
  "name": "@inkbrick/spellcheck",
  "version": "0.1.0-alpha.0",
  "description": "Spelling suggestions from Hunspell dictionaries (nspell), off the main thread in a Web Worker. Used by the Inkbrick editor for corrections in its context menu; works without the editor too.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./src/worker.ts",
    "./dist/worker.js"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@types/nspell": "^2.1.6",
    "dictionary-en": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./worker": {
        "types": "./dist/worker.d.ts",
        "import": "./dist/worker.js"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CyberWizard6090/Inkbrick.git",
    "directory": "packages/spellcheck"
  }
}
