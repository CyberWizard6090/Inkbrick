{
  "name": "inkbrick",
  "version": "0.1.0",
  "repository": "https://github.com/CyberWizard6090/Inkbrick.git",
  "author": "CYBERWIZARD <mail.maxim6090@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter sandbox dev",
    "dev:phone": "pnpm --filter sandbox dev --host 0.0.0.0",
    "build": "pnpm --filter sandbox build",
    "build:packages": "pnpm -r --filter \"@inkbrick/*\" build",
    "preview": "pnpm --filter sandbox preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:api": "typedoc",
    "size": "node scripts/size.mjs",
    "bench": "pnpm --filter @inkbrick/react exec vitest run --config bench/vitest.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:codegen": "playwright codegen http://127.0.0.1:5173",
    "test:e2e:install": "playwright install",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "0.25.12",
    "eslint": "^10.14.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.0.1",
    "prettier": "^3.9.0",
    "tsup": "8.5.0",
    "typedoc": "0.28.20",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=4 <6": "^5.0.12",
      "js-yaml@>=4 <5": "^4.3.2",
      "nanoid@<4": "^3.3.20",
      "postcss@<9": "^8.5.32",
      "browserslist@<5": "^4.29.5",
      "source-map-js@<2": "^1.2.2",
      "baseline-browser-mapping@<3": "^2.11.34",
      "minimatch@>=9 <11": "^11.0.1",
      "undici@>=7 <8": "^7.30.1",
      "jsdom": "^29.1.1",
      "typedoc>minimatch": "^10.2.5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-g3hv-75wg-m249"
      ]
    }
  },
  "packageManager": "pnpm@9.15.2"
}
